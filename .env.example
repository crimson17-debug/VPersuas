# Razorpay test mode. No KYC required — generate from the dashboard under
# Account & Settings -> API Keys. Keys must start with rzp_test_; the client
# refuses a live key, because this system creates payment links and has no
# business spending real customers' money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Secret configured on the webhook in the dashboard. Used to verify the
# X-Razorpay-Signature header against the RAW request body.
RAZORPAY_WEBHOOK_SECRET=

# Subscribe the webhook to: payment.captured, payment.failed, order.paid,
# payment_link.paid
